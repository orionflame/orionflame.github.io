{
  "manifest_version": 3,
  "name": "Chat Mode Observer + Classic UI",
  "version": "0.2.0",
  "description": "Passive Chat request metadata observer and optional first-party UI-driven classic overlay for chatgpt.com",
  "permissions": ["storage"],
  "content_scripts": [
    {"matches":["https://chatgpt.com/*"],"run_at":"document_start","world":"MAIN","js":["observer-main.js"]},
    {"matches":["https://chatgpt.com/*"],"run_at":"document_start","world":"ISOLATED","js":["panel.js"]},
    {"matches":["https://chatgpt.com/*"],"run_at":"document_idle","world":"ISOLATED","js":["dom-adapter.js","classic-overlay.js"]}
  ]
}
